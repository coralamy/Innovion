# Environment variables — never commit real credentials
.env
.env.local
.env.production.local
.env.development.local

# Node modules
node_modules/

# NOTE (Team A, 2026-08-17): package-lock.json is deliberately NOT ignored.
# It was previously listed here, which meant it was never committed. A clean
# clone therefore had no lockfile, `npm ci` was impossible, and every install
# silently re-resolved the full transitive dependency tree — incompatible with
# a reproducible, auditable build. The lockfile must be committed and reviewed
# like any other source file.

# Next.js build output
.next/
out/

# Production build
build/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS-specific files
.DS_Store
Thumbs.db

# Vercel deployment
.vercel/

# Optional: if using TypeScript
*.tsbuildinfo

# Optional: if using testing tools
coverage/
jest-test-results.json

# Optional: if using IDEs
.vscode/
.idea/

# Optional: if using TurboRepo or monorepo
turbo/
# Supabase CLI local cache
supabase/.temp/
