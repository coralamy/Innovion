{
  "name": "innovion",
  "version": "0.1.0",
  "private": true,
  "rocketCritical": {
    "dependencies": [
      "next",
      "react",
      "react-dom",
      "@dhiwise/component-tagger",
      "@tailwindcss/typography",
      "recharts"
    ],
    "devDependencies": [
      "typescript",
      "@types/node",
      "@types/react",
      "@types/react-dom",
      "@typescript-eslint/eslint-plugin",
      "@typescript-eslint/parser",
      "eslint-config-next",
      "tailwindcss",
      "autoprefixer",
      "postcss",
      "eslint",
      "prettier",
      "@netlify/plugin-nextjs"
    ],
    "scripts": [
      "dev",
      "build",
      "start",
      "lint",
      "lint:fix",
      "format",
      "serve",
      "type-check"
    ],
    "warning": "🚨 CRITICAL: DO NOT REMOVE OR MODIFY ABOVE DEPENDENCIES - Required for Next.js 15 TypeScript app functionality"
  },
  "scripts": {
    "dev": "next dev -p 4028",
    "build": "next build",
    "start": "next dev -p 4028",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md,json}\" \"tests/**/*.ts\" \"supabase/tests/*.mjs\"",
    "serve": "next start",
    "type-check": "tsc --noEmit",
    "test:security": "node supabase/tests/security-suite.mjs",
    "test:schema": "node supabase/tests/schema-conformance.mjs",
    "test:app": "node --import tsx --conditions=react-server tests/app-security-suite.ts",
    "test:controls": "node supabase/tests/dead-controls.mjs",
    "test:integration": "node supabase/tests/integration-security-suite.mjs",
    "test:workforce": "node --import tsx --conditions=react-server tests/workforce-contract-suite.ts",
    "test": "npm run test:security && npm run test:schema && npm run test:app && npm run test:controls && npm run test:workforce",
    "test:abd": "npm run test && npm run test:integration && npm run test:replay",
    "verify": "npm run type-check && npm run lint && npm run test && npm run build",
    "rc2": "ts-node scripts/rc2-test-suite.ts",
    "sync-validate": "ts-node scripts/sync-validation.ts",
    "tenant-test": "ts-node scripts/tenant-isolation-rbac-test.ts",
    "mobile-check": "ts-node scripts/mobile-readiness-check.ts",
    "smoke-test": "ts-node scripts/smoke-test.ts",
    "validate-env": "ts-node scripts/validate-env.ts",
    "pilot-readiness": "ts-node scripts/rc2-test-suite.ts && ts-node scripts/sync-validation.ts && ts-node scripts/tenant-isolation-rbac-test.ts && ts-node scripts/mobile-readiness-check.ts",
    "test:replay": "node supabase/tests/migration-replay-suite.mjs",
    "test:rehearsal": "node supabase/tests/restored-copy-rehearsal.mjs"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@supabase/ssr": "0.12.3",
    "@supabase/supabase-js": "2.110.8",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "lucide-react": "^1.7.0",
    "next": "15.5.23",
    "react": "19.0.3",
    "react-dom": "19.0.3",
    "react-hook-form": "^7.83.0",
    "recharts": "^2.15.2",
    "server-only": "^0.0.1",
    "sonner": "^1.7.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "@eslint/eslintrc": "^3",
    "@netlify/plugin-nextjs": "^5.11.1",
    "@types/node": "^20",
    "@types/react": "19.0.3",
    "@types/react-dom": "19.0.3",
    "@typescript-eslint/eslint-plugin": "^8.29.0",
    "@typescript-eslint/parser": "^8.29.0",
    "autoprefixer": "10.4.2",
    "eslint": "^9",
    "eslint-config-next": "^15.2.4",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "postcss": "8.5.26",
    "prettier": "^3.5.3",
    "tailwindcss": "3.4.6",
    "tailwindcss-animate": "^1.0.7",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
